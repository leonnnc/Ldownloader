# ===========================================================================
# Configuración del servicio de descargas
# Copiar a /etc/downloader.env y ajustar. systemd lo lee con EnvironmentFile.
# ===========================================================================

# --- Servidor --------------------------------------------------------------
VDL_HOST=0.0.0.0
VDL_PORT=8000
VDL_DATA_DIR=/var/lib/downloader

# --- Motor: mantenimiento automático (lo más importante) -------------------
# Sin esto, el servicio se degrada solo cuando los sitios cambian.
VDL_AUTO_UPDATE=true
VDL_UPDATE_INTERVAL_HOURS=12
VDL_UPDATE_CHANNEL=stable          # stable | nightly
VDL_UPDATE_ROLLBACK=true

# Cómo se reinicia el servicio tras instalar una versión nueva.
# La opción A (recomendada con systemd/docker) delega en el supervisor:
VDL_RESTART_AFTER_UPDATE=true
# La opción B ejecuta una orden externa (útil si actualizas por temporizador):
# VDL_RESTART_COMMAND=systemctl restart downloader-api

# --- Canarios: enterarte antes que los usuarios ----------------------------
VDL_CANARY_ENABLED=true
VDL_CANARY_INTERVAL_MINUTES=30
VDL_CANARY_MIN_PASS_RATE=60
VDL_CANARY_ALERT_AFTER=3
VDL_CANARY_FILE=/opt/downloader/backend/canaries.json

# --- Alertas ---------------------------------------------------------------
# Slack, Discord, n8n o cualquier webhook que acepte JSON por POST.
# VDL_ALERT_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Reintentos y circuit breaker -----------------------------------------
VDL_RETRY_ATTEMPTS=3
VDL_RETRY_BASE_DELAY=2
VDL_CIRCUIT_THRESHOLD=5
VDL_CIRCUIT_COOLDOWN=180

# --- Límites y abuso -------------------------------------------------------
VDL_MAX_CONCURRENT_JOBS=2
VDL_MAX_FILESIZE_MB=0
VDL_FILE_TTL_MINUTES=15
VDL_RATE_LIMIT_REQUESTS=20
VDL_RATE_LIMIT_WINDOW=60

# --- Dominios permitidos ---------------------------------------------------
# En producción conviene restringir. Vacío = todos los que yt-dlp soporte.
# VDL_ALLOWED_DOMAINS=facebook.com,instagram.com,tiktok.com

# --- Sesiones (contenido que exige login) ----------------------------------
# Un solo archivo:
# VDL_COOKIES_FILE=/opt/downloader/cookies.txt
# O una carpeta con varios, que se rotan (más resistente a bloqueos):
# VDL_COOKIES_DIR=/opt/downloader/cookies

# --- Clientes de reproducción (YouTube, cuando hay bloqueos) ---------------
# Vacío = comportamiento por defecto de yt-dlp.
# VDL_PLAYER_CLIENTS=default,web_safari,android

# --- Administración --------------------------------------------------------
# Habilita /api/admin/* (actualizar, recargar canarios, reiniciar).
# Genera uno con: openssl rand -hex 24
# VDL_ADMIN_TOKEN=

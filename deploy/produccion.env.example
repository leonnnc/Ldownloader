# ===========================================================================
# Configuración de PRODUCCIÓN
# Copia este archivo a deploy/produccion.env y ajusta los valores.
# produccion.env NO se sube a git.
# ===========================================================================

# --- Motor: mantenimiento automático (lo más importante) -------------------
VDL_AUTO_UPDATE=true
VDL_UPDATE_INTERVAL_HOURS=12
VDL_UPDATE_CHANNEL=stable
VDL_UPDATE_ROLLBACK=true
# Docker reinicia el contenedor cuando el actualizador sale.
VDL_RESTART_AFTER_UPDATE=true

# --- Canarios: detectar roturas antes que los usuarios --------------------
VDL_CANARY_ENABLED=true
VDL_CANARY_INTERVAL_MINUTES=30
VDL_CANARY_MIN_PASS_RATE=60
VDL_CANARY_ALERT_AFTER=3
VDL_CANARY_FILE=/app/canaries.json

# --- Alertas --------------------------------------------------------------
# IMPRESCINDIBLE en producción. Sin esto no te enteras de las caídas.
# Slack, Discord, n8n o cualquier webhook que acepte JSON por POST.
VDL_ALERT_WEBHOOK=

# --- Proxies: la capa que decide si el servicio sobrevive ------------------
# Sin proxies, los sitios grandes bloquearán la IP del servidor en días.
# VDL_PROXY=http://usuario:clave@proxy.tuproveedor.com:8080
# VDL_PROXY_MAP=youtube=http://u:p@host:8080,facebook=http://u:p@host:8081

# --- Seguridad ------------------------------------------------------------
# Genera el token con:  openssl rand -hex 24
VDL_ADMIN_TOKEN=

# Restringe los dominios que ofreces. Déjalo vacío solo si quieres
# comportarte como un proxy abierto (no recomendado).
VDL_ALLOWED_DOMAINS=facebook.com,fb.watch,instagram.com,tiktok.com

# --- Historial de descargas del panel -------------------------------------
# Guarda IP + enlace + formato + resultado de cada descarga. Es útil para
# responder a reclamaciones, pero es un dato personal: el archivo está en
# .gitignore y conviene montarlo en un volumen que no se copie a los backups,
# o apagarlo con VDL_HISTORY_ENABLED=false si no lo quieres en el servidor.
VDL_HISTORY_ENABLED=true
VDL_HISTORY_MAX=300
# VDL_HISTORY_FILE=/app/data/history.jsonl

# Carrusel público de la portada: enseña título + miniatura + plataforma de las
# últimas descargas (nunca la IP ni el enlace). Ponlo a false si no quieres que
# la portada muestre la actividad de nadie.
VDL_GALLERY_ENABLED=true
VDL_GALLERY_MAX=12
VDL_GALLERY_MIN=2

# --- Límites y abuso ------------------------------------------------------
VDL_MAX_CONCURRENT_JOBS=3
VDL_MAX_FILESIZE_MB=500
VDL_FILE_TTL_MINUTES=15
VDL_RATE_LIMIT_REQUESTS=20
VDL_RATE_LIMIT_WINDOW=60

# --- Cookies (opcional, para contenido que exige sesión) ------------------
# VDL_COOKIES_DIR=/app/cookies

# --- Clientes de reproducción (YouTube, cuando hay bloqueos) --------------
# VDL_PLAYER_CLIENTS=default,web_safari,android

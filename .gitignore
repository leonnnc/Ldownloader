# ---------------------------------------------------------------
# Entorno y dependencias
# ---------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

# ---------------------------------------------------------------
# Datos en tiempo de ejecucion
# ---------------------------------------------------------------
storage/
data/
downloads/
cookies.txt
cookies/

# Token de administracion generado localmente. NUNCA debe subirse:
# cualquiera con este valor puede reiniciar el servicio y borrar archivos.
ADMIN-TOKEN.txt

# ---------------------------------------------------------------
# Registros y configuracion local
# ---------------------------------------------------------------
*.log
.env
.env.*

# Configuración de producción: contiene el token de administración y el
# webhook de alertas. Solo existe en el servidor.
deploy/produccion.env

# ---------------------------------------------------------------
# Android
# ---------------------------------------------------------------
.gradle/
build/
local.properties
keystore.properties
*.jks
*.keystore
captures/
.externalNativeBuild/
.cxx/
*.iml
.idea/

# El SDK de Android es propio de cada maquina
android-sdk/

# ---------------------------------------------------------------
# Sistema operativo y editores
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.swp
*~

# Estado en tiempo de ejecucion del actualizador
backend/update_state.json

# Historial de descargas del panel: contiene direcciones IP y enlaces, que son
# datos personales de quien uso el servicio. No debe acabar en el repositorio.
backend/history.jsonl
history.jsonl

# Informe interno de revision tecnica: describe fallos de seguridad que todavia
# no estan corregidos. El repositorio es publico, asi que esto se queda fuera.
REVISION.md

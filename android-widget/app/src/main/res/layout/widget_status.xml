<?xml version="1.0" encoding="utf-8"?>
<!--
    Solo vistas permitidas por RemoteViews. Un widget no puede inflar
    cualquier layout, así que aquí no hay nada fuera de la lista oficial
    (LinearLayout, TextView, ImageView, Button…).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Cabecera: punto de color + estado + hace cuánto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/status_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:contentDescription="@null"
            android:src="@drawable/dot_unknown" />

        <TextView
            android:id="@+id/status_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_unknown"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_never"
            android:textColor="@color/text_faint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Último problema -->
    <TextView
        android:id="@+id/problem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Métricas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/metric_rate"
            style="@style/WidgetMetric"
            android:text="@string/widget_unknown" />

        <TextView
            android:id="@+id/metric_circuits"
            style="@style/WidgetMetric"
            android:text="—" />

        <TextView
            android:id="@+id/metric_engine"
            style="@style/WidgetMetric"
            android:text="—" />
    </LinearLayout>

    <!-- Aviso de reinicio recomendado -->
    <TextView
        android:id="@+id/advice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/warn"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Acciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_refresh"
            style="@style/WidgetButton"
            android:text="@string/widget_btn_refresh" />

        <!--
            Solo aparece cuando la conexión se ha dado por perdida. Ofrecer
            «Circuitos» y «Reiniciar» en ese momento sería ofrecer botones que
            no pueden funcionar: sin servidor no hay nada que reiniciar.
        -->
        <Button
            android:id="@+id/btn_reconnect"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:text="@string/widget_btn_reconnect"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_reset"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:text="@string/widget_btn_reset" />

        <Button
            android:id="@+id/btn_restart"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:text="@string/widget_btn_restart" />
    </LinearLayout>

</LinearLayout>
